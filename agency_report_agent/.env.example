# Copy this file to ".env" and fill in your key to use live mode.
# Mock mode (the default) needs none of this and costs nothing.

# Your Anthropic API key (only needed for --live). Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model writes the draft in live mode.
# Default is claude-opus-5-5 (most capable).
# To cut cost by roughly 20x for this simple drafting job, use Haiku instead:
# AGENT_MODEL=claude-haiku-4-5
AGENT_MODEL=claude-opus-5-5
